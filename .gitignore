# ── Node ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Environment / secrets ─────────────────────────────
.env
.env.*
!.env.example

# ── NestJS / TypeScript build ─────────────────────────
backend/dist/
backend/*.tsbuildinfo

# ── Storage / uploads (runtime data) ─────────────────
backend/storage/

# ── MediaPipe Models (large files) ───────────────────
backend/ml-models/*.tflite
backend/ml-models/*.task
!backend/ml-models/README.md

# ── OS / editor ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.pem

# ── Debug + scratch markdown ─────────────────────────
# Stray notes / troubleshooting / TODO files should never ship to
# production. The allow-list below keeps repo-conventional MDs
# (README, CLAUDE, AGENTS) tracked; anything else in frontend/portal
# or backend root is auto-ignored so a `git add .` after a debugging
# session doesn't accidentally push notes to the VPS.
frontend/portal/*.md
!frontend/portal/README.md
!frontend/portal/CLAUDE.md
!frontend/portal/AGENTS.md

backend/*.md
!backend/README.md
!backend/CLAUDE.md
!backend/AGENTS.md

# Real docs go under docs/ at the repo root — those ARE tracked.

# ── Logs ──────────────────────────────────────────────
*.log
logs/
