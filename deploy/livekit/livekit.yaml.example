# LiveKit server config — copy to livekit.yaml and edit before starting.
# Generate api_key/secret with: docker run --rm livekit/livekit-cli create-token --help
# Or just invent your own — anything random > 32 chars works.

port: 7880
bind_addresses:
  - ""                      # bind to all interfaces (host networking)

rtc:
  tcp_port: 7881
  udp_port: 7882            # this is the TURN/UDP port; clients fall back here when 50000-60000 is blocked
  port_range_start: 50000
  port_range_end: 60000
  # Set this to your server's PUBLIC IPv4 — required for NAT traversal.
  # If left empty, LiveKit tries to auto-discover via STUN, which sometimes fails.
  use_external_ip: true

redis:
  address: 127.0.0.1:6379

keys:
  # Format:  api_key: api_secret
  # IMPORTANT: also put these into the backend .env as LIVEKIT_API_KEY / LIVEKIT_API_SECRET
  APIaaaaaaaaaaaaaaaa: bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Optional: built-in TURN (if you don't want to set up a separate TURN server)
turn:
  enabled: true
  domain: livekit.yourdomain.com   # the hostname you'll point at this server
  tls_port: 5349                   # standard turns:// port (requires cert below)
  udp_port: 3478                   # standard turn:// port
  external_tls: true               # nginx terminates TLS on 5349

# Logging
logging:
  level: info
  json: false
