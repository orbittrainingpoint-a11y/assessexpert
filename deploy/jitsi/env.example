# ==========================================================
# Jitsi self-host configuration for AssessExpert
# Copy this to `.env` and fill in the marked values before running docker-compose.
# ==========================================================

# Directory where Jitsi keeps its config files (relative or absolute)
CONFIG=./jitsi-meet-cfg

# Public-facing URL — change to your actual subdomain
PUBLIC_URL=https://meet.assessexpert.com

# Ports — keep defaults unless you have port conflicts
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=Asia/Kolkata

# JVB (video bridge)
JVB_PORT=10000
JVB_TCP_PORT=4443
JVB_TCP_MAPPED_PORT=4443
# Enable TCP fallback so clients behind strict firewalls can still connect
JVB_TCP_HARVESTER_DISABLED=false
# Public STUN servers used by JVB itself to discover its own public IP
JVB_STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302
# Colibri WebSocket — required for modern Jitsi bridge channel
ENABLE_COLIBRI_WEBSOCKET=1
JVB_WS_DOMAIN=meet.assessexpert.com
# Advertise the VPS public IP to ICE candidates (same as DOCKER_HOST_ADDRESS)
JVB_ADVERTISE_IPS=YOUR.VPS.PUBLIC.IP

# REPLACE — public IP of your VPS so external clients can reach the bridge
DOCKER_HOST_ADDRESS=YOUR.VPS.PUBLIC.IP

# JWT auth — backend uses these to mint tokens
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=1
JWT_APP_ID=assessexpert
# REPLACE — generate via `openssl rand -hex 32` and use the same value in backend .env
JWT_APP_SECRET=CHANGEME_USE_OPENSSL_RAND_HEX_32
JWT_ACCEPTED_ISSUERS=assessexpert
JWT_ACCEPTED_AUDIENCES=jitsi
TOKEN_AUTH_URL=

# Internal XMPP — the gen-passwords.sh script fills these in
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_PORT=5222
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280

# Internal auth — generated by gen-passwords.sh
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=
JVB_BREWERY_MUC=jvbbrewery

# TURN server (coturn) — relay for candidates behind strict firewalls
# coturn runs on the same VPS. Install: apt install coturn
# /etc/turnserver.conf key settings:
#   listening-port=3478
#   tls-listening-port=5349
#   fingerprint
#   lt-cred-mech
#   user=assessexpert:CHANGEME_TURN_PASSWORD
#   realm=meet.assessexpert.com
#   cert=/etc/letsencrypt/live/meet.assessexpert.com/fullchain.pem
#   pkey=/etc/letsencrypt/live/meet.assessexpert.com/privkey.pem
#   no-multicast-peers
#   denied-peer-ip=10.0.0.0-10.255.255.255
#   denied-peer-ip=192.168.0.0-192.168.255.255
# Required open ports: 3478/UDP+TCP, 5349/TCP, 49152-65535/UDP (relay range)
TURN_CREDENTIALS=assessexpert:CHANGEME_TURN_PASSWORD

# XMPP WebSocket — required for lib-jitsi-meet wss:// connection
ENABLE_XMPP_WEBSOCKET=1

# Misc
ENABLE_P2P=false
ENABLE_RECORDING=false
ENABLE_SIMULCAST=true
ENABLE_PREJOIN_PAGE=false
ENABLE_WELCOME_PAGE=false
RESOLUTION=720
RESOLUTION_MIN=180
START_AUDIO_MUTED=10
START_VIDEO_MUTED=10
LOG_LEVEL=INFO
