# AssessExpert backend env — copy to .env and fill in real values.
# All secrets should be unique random strings. Use:
#   openssl rand -hex 32
# to generate each.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://assessexpert_app:CHANGE_ME@localhost:5432/assessexpert?schema=public"

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── JWT secrets ──────────────────────────────────────────────────────────────
# Must be ≥32 chars each, MUST DIFFER from each other. Backend refuses to
# boot otherwise (see backend/src/main.ts).
JWT_SECRET=CHANGE_ME_to_a_random_32plus_char_string
JWT_REFRESH_SECRET=CHANGE_ME_to_a_DIFFERENT_random_32plus_char_string

# ── Cookie / CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. The portal must be in
# here or websocket upgrades will be CORS-rejected.
FRONTEND_URLS=https://assessexpert.com,http://localhost:3000

# Used in magic-link emails (the public URL that hosts the candidate exam /
# interview page). Falls back to first entry of FRONTEND_URLS if unset.
FRONTEND_URL=https://assessexpert.com

# ── SMTP (transactional email) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME_smtp_app_password
SMTP_FROM=noreply@yourdomain.com

# ── Cloudflare TURN (firewall-friendly WebRTC relay) ─────────────────────────
# Get these from https://dash.cloudflare.com/?to=/:account/calls/turn
# If unset, the backend cleanly falls back to self-hosted coturn only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where uploaded files (reference photos, recordings, captures) are written.
# Must be writable by the backend process; coupled with the /uploads static
# mount in main.ts so the frontend can fetch by relative path.
STORAGE_PATH=/var/www/html/assessexpert/backend/storage

# ── Redis (rate-limit + cache) ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MediaPipe / AI ───────────────────────────────────────────────────────────
# Set to false to skip server-side periodic FR (saves CPU on weak boxes).
MEDIAPIPE_ENABLED=true

# ── Optional: speech transcription ───────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
