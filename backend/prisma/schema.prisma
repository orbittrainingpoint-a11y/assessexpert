// prisma/schema.prisma
// assessexpert Platform — Local PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  MASTER_PROCTOR
  EXAM_SETUP_MASTER
  SALES_AGENT
  ORG_ADMIN
  HR_MANAGER
  HIRING_MANAGER
  PROCTOR
  CMS_ADMIN
  CMS_EDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum SessionStatus {
  SCHEDULED
  INVITED
  WAITING_ROOM
  CHECKLIST
  VERIFICATION_IN_PROGRESS
  MCQ_IN_PROGRESS
  MCQ_COMPLETE
  PRACTICAL_IN_PROGRESS
  SUBMITTED
  GRADING
  PENDING_PROCTOR_REVIEW
  REPORT_PUBLISHED
  CANCELLED
  NO_SHOW
  DISQUALIFIED
}

enum ReportStatus {
  DRAFT
  PENDING_REVIEW
  RETURNED
  PUBLISHED
}

enum ProctorVerdict {
  PASS
  FAIL
  CONDITIONAL
  FLAGGED
  DISQUALIFIED
}

enum PracticalQuality {
  EXCELLENT
  GOOD
  SATISFACTORY
  POOR
  DID_NOT_SUBMIT
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ARCHIVED
}

enum PracticalType {
  CAD
  CODING
  LAB
  FILE
  NONE
}

enum PracticalAnswerType {
  FILE_UPLOAD
  NUMERIC
  TEXT
}

enum NumericMatchMode {
  EXACT
  TOLERANCE
}

enum TextMatchMode {
  EXACT
  CONTAINS
  MANUAL
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CandidateSessionStatus {
  PENDING
  JOINED
  VERIFYING
  VERIFIED
  MCQ_IN_PROGRESS
  MCQ_SUBMITTED
  PRACTICAL_IN_PROGRESS
  PRACTICAL_SUBMITTED
  COMPLETED
  DISQUALIFIED
}

enum CandidateSource {
  UPLOAD
  MANUAL
}

enum EventType {
  FACE_ABSENT
  FACE_MULTIPLE
  GAZE_OFFSCREEN
  AUDIO_ANOMALY
  TAB_SWITCH
  COPY_PASTE_ATTEMPT
  FULLSCREEN_EXIT
  DUPLICATE_LOGIN
  GUARDPRO_DISCONNECT
  VM_DETECTED
  PROCTOR_WARNING
  SESSION_PAUSED
  SESSION_TERMINATED
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum EventSource {
  AI
  GUARDPRO
  PROCTOR
  SYSTEM
}

enum ReviewOutcome {
  DISMISSED
  CONFIRMED
  ESCALATED
}

enum FREventType {
  PRE_EXAM_ID
  PERIODIC_CHECK
  LIVE_ANOMALY
}

enum FROutcome {
  VERIFIED
  PENDING_REVIEW
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  NEGOTIATING
  CONVERTED
  LOST
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  tradingName          String?
  country              String
  city                 String?
  industry             String
  size                 String?
  website              String?
  logo                 String?
  address              String?
  taxRegNumber         String?
  status               OrgStatus @default(ACTIVE)
  brandingConfig       Json?
  contractStartDate    DateTime?
  contractEndDate      DateTime?
  assessmentCredits    Int       @default(0)
  creditsUsed          Int       @default(0)
  maxConcurrentSessions Int      @default(5)
  recordingRetentionDays Int     @default(7)
  reportingLanguage    String    @default("en")
  // Org-level timezone used for every candidate-facing email and any
  // dashboard timestamp formatting. Falls back to Asia/Dubai for
  // historical rows so existing customers don't suddenly see UTC times
  // in reminder emails after the migration.
  timezone             String    @default("Asia/Dubai")
  allowedAssessmentTypes String[]
  accountTier          String    @default("STANDARD")
  internalNotes        String?
  assignedSalesAgentId String?
  primaryContactName   String?
  primaryContactEmail  String?
  primaryContactPhone  String?
  billingContactName   String?
  billingContactEmail  String?
  users                User[]
  candidates           CandidateRecord[]
  sessions             ExamSession[]
  reports              Report[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String?
  role              UserRole
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  firstName         String
  lastName          String
  phone             String?
  jobTitle          String?
  profilePhoto      String?
  timezone          String     @default("UTC")
  preferredLanguage String     @default("en")
  mfaEnabled        Boolean    @default(false)
  mfaSecret         String?
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  certificationLevel String?
  certificationDomains String[]
  languages         String[]
  maxSessionsPerDay Int?
  region            String?
  specialistDomains String[]
  accessLevel       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model AssessmentType {
  id                     String           @id @default(cuid())
  name                   String
  shortCode              String           @unique
  category               String
  industry               String
  jobRole                String
  description            String?
  mcqTimeLimit           Int              @default(30)
  mcqQuestionCount       Int              @default(25)
  mcqPassThreshold       Float            @default(60.0)
  practicalType          PracticalType    @default(NONE)
  practicalTimeLimit     Int              @default(60)
  practicalPassThreshold Float            @default(60.0)
  mcqWeight              Float            @default(50.0)
  practicalWeight        Float            @default(50.0)
  overallPassLogic       String           @default("BOTH")
  overallPassThreshold   Float            @default(60.0)
  requiresGuardPro       Boolean          @default(false)
  blockedApplications    String[]
  blockMultiMonitor      Boolean          @default(false)
  blockVirtualMachines   Boolean          @default(false)
  allowClipboard         Boolean          @default(false)
  languages              String[]         @default(["en"])
  status                 AssessmentStatus @default(DRAFT)
  createdBy              String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  questions              Question[]
  practicalTasks         PracticalTask[]
  practicalPaperSets     PracticalPaperSet[]
  sessions               ExamSession[]
}

model Question {
  id               String         @id @default(cuid())
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  type             QuestionType
  content          Json           // {text, imageUrl?, codeBlock?}
  options          Json           // [{key: "A", text: "..."}]
  correctAnswer    Json           // ["B"] or ["A","C"]
  explanation      String?
  difficulty       Difficulty
  domain           String
  tags             String[]
  marks            Float          @default(1.0)
  language         String         @default("en")
  status           QuestionStatus @default(DRAFT)
  aiGenerated      Boolean        @default(false)
  usageCount       Int            @default(0)
  version          Int            @default(1)
  versionHistory   Json?
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  answers          ExamAnswer[]
}

model SessionQuestionAssignment {
  id                   String      @id @default(cuid())
  sessionId            String
  session              ExamSession @relation(fields: [sessionId], references: [id])
  // Multi-candidate slots get one assignment ROW per candidate so each
  // candidate has their own shuffled question order. Backfilled from
  // session.candidateId for legacy single-candidate sessions.
  candidateId          String
  questionIds          String[]
  questionOrder        Json
  shuffleSeed          String
  generatedAt          DateTime    @default(now())
  generatedByProctorId String

  @@unique([sessionId, candidateId])
}

model PracticalTask {
  id               String         @id @default(cuid())
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  type             PracticalType
  title            String
  description      String
  starterFilePath  String?
  starterFileName  String?
  rubricData       Json
  rubricFilePath   String?
  acceptedFileTypes String[]
  difficulty       String         @default("STANDARD")
  estimatedMinutes Int?
  evaluatorNotes   String?
  testCases        Json?
  status           TaskStatus     @default(DRAFT)
  version          Int            @default(1)
  versionHistory   Json?
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         ExamSession[]
  sessionCandidates SessionCandidate[]
}

// ── Practical Paper Sets ───────────────────────────────────────────────
// A Paper Set groups N ordered (no shuffle) questions with shared file
// references. Different candidates can be assigned different sets so
// neighbours can't easily copy.

model PracticalPaperSet {
  id               String              @id @default(cuid())
  assessmentTypeId String
  assessmentType   AssessmentType      @relation(fields: [assessmentTypeId], references: [id])
  name             String              // "Set 1", "Set A", etc.
  description      String?
  status           QuestionStatus      @default(DRAFT)
  files            PracticalSetFile[]
  questions        PracticalQuestion[]
  sessions         ExamSession[]
  sessionCandidates SessionCandidate[]
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([assessmentTypeId, name])
  @@index([assessmentTypeId, status])
}

// File library shared across all questions in a set. Candidates can
// download these to use as inputs (drawings, datasheets, source code).
model PracticalSetFile {
  id        String            @id @default(cuid())
  setId     String
  set       PracticalPaperSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  fileName  String            // display name shown to candidate
  filePath  String            // server-side storage path
  fileSize  Int               // bytes
  mimeType  String?
  uploadedBy String
  createdAt DateTime          @default(now())

  questionRefs PracticalQuestionFile[]
}

model PracticalQuestion {
  id               String              @id @default(cuid())
  setId            String
  set              PracticalPaperSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  position         Int                 // order within the set, NO shuffle
  prompt           String              // the question text
  answerType       PracticalAnswerType
  marks            Float               @default(1.0)
  rubric           String?             // grader-facing notes

  // FILE_UPLOAD-only fields
  acceptedFileTypes String[]           @default([])  // e.g. [".dwg", ".pdf"]
  maxFileSizeMB    Int?                              // hard cap

  // NUMERIC-only fields
  expectedNumericAnswer Float?
  numericTolerance      Float?         // ± tolerance
  numericUnit           String?        // "mm", "kg", etc.
  numericMatchMode      NumericMatchMode @default(TOLERANCE)

  // TEXT-only fields
  expectedTextAnswer String?
  textMatchMode      TextMatchMode    @default(MANUAL)
  textCaseSensitive  Boolean          @default(false)

  fileRefs        PracticalQuestionFile[]   // referenced PracticalSetFile rows
  answers         PracticalAnswer[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([setId, position])
  @@index([setId])
}

// Many-to-many between questions and the set's files
model PracticalQuestionFile {
  id         String           @id @default(cuid())
  questionId String
  question   PracticalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  fileId     String
  file       PracticalSetFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([questionId, fileId])
}

model PracticalAnswer {
  id               String              @id @default(cuid())
  sessionId        String
  session          ExamSession         @relation(fields: [sessionId], references: [id])
  // Which candidate submitted this answer. Backfilled from session.candidateId
  // for legacy single-candidate sessions; required so multi-candidate slots
  // don't collide into a shared bucket via the (sessionId, questionId) key.
  candidateId      String
  questionId       String
  question         PracticalQuestion   @relation(fields: [questionId], references: [id])

  // Submitted answer — exactly one of these populated based on question.answerType
  uploadedFilePath String?
  uploadedFileName String?
  uploadedFileSize Int?
  numericValue     Float?
  textValue        String?
  submittedAt      DateTime?

  // Grading
  marks            Float?
  maxMarks         Float?
  isCorrect        Boolean?
  autoGraded       Boolean             @default(false)
  graderNotes      String?
  gradedAt         DateTime?
  gradedBy         String?

  @@unique([sessionId, candidateId, questionId])
  @@index([sessionId, candidateId])
}

model CandidateRecord {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  email          String
  firstName      String
  lastName       String
  phone          String?
  jobPosition    String
  yearsExperience String?
  department     String?
  notes          String?
  batchId        String?
  source         CandidateSource @default(MANUAL)
  // One-time reference photo captured from the candidate's webcam during
  // their first OTP-verified session. Used as the baseline for facial
  // recognition checks (pre-exam ID + periodic during exam).
  // Path is relative to STORAGE_PATH, e.g. "candidate-photos/<id>.jpg".
  referencePhotoPath        String?
  referencePhotoCapturedAt  DateTime?
  // Cached face embedding (JSON-stringified Float[]) extracted from
  // referencePhotoPath. Pre-computed so FR comparisons during the exam
  // don't have to re-run MediaPipe on the reference image each time.
  referenceFaceEmbedding    String?
  sessions       ExamSession[]
  sessionCandidates SessionCandidate[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([email, organizationId])
}

model ExamSession {
  id               String         @id @default(cuid())
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  candidateId      String
  candidate        CandidateRecord @relation(fields: [candidateId], references: [id])
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  proctorId        String?
  scheduledAt      DateTime
  magicToken       String         @unique
  tokenExpiresAt   DateTime
  tokenUsedAt      DateTime?
  tokenUsedFromIp  String?
  status           SessionStatus  @default(SCHEDULED)
  isMultiCandidate Boolean        @default(false)
  // Length of the booking slot in minutes (default 1 hour). Candidates
  // scheduled with the same proctor + assessment whose time falls inside
  // an existing slot's [scheduledAt, scheduledAt + slotDurationMinutes)
  // window are auto-grouped into that one slot/session.
  slotDurationMinutes Int         @default(60)
  checklistCompletedAt   DateTime?
  mcqStartedAt           DateTime?
  mcqSubmittedAt         DateTime?
  practicalTaskId        String?
  practicalTask          PracticalTask? @relation(fields: [practicalTaskId], references: [id])
  practicalPaperSetId    String?
  practicalPaperSet      PracticalPaperSet? @relation(fields: [practicalPaperSetId], references: [id])
  practicalStartedAt     DateTime?
  practicalSubmittedAt   DateTime?
  practicalFilePath      String?
  practicalFileName      String?
  guardproConnected      Boolean        @default(false)
  candidateIp            String?
  screenRecordingPath    String?
  webcamRecordingPath    String?
  recordingExpiresAt     DateTime?
  recordingPurged        Boolean        @default(false)
  integrityScore         Float?
  disqualified           Boolean        @default(false)
  disqualifyReason       String?
  // Pre-exam verification transcript. JSON array of utterances:
  // [{ candidateId?, speaker: 'PROCTOR' | 'CANDIDATE', text, timestamp }]
  // Append-only from the app; the report viewer renders it read-only.
  verificationTranscript Json?
  questionAssignments    SessionQuestionAssignment[]
  answers                ExamAnswer[]
  practicalAnswers       PracticalAnswer[]
  events                 SessionEvent[]
  frLogs                 FacialRecognitionLog[]
  checklists             ProctorChecklist[]
  reports                Report[]
  sessionCandidates      SessionCandidate[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model SessionCandidate {
  id                String                  @id @default(cuid())
  sessionId         String
  session           ExamSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         CandidateRecord         @relation(fields: [candidateId], references: [id])
  status            CandidateSessionStatus  @default(PENDING)
  socketId          String?
  joinedAt          DateTime?
  verifiedAt        DateTime?
  mcqStartedAt      DateTime?
  mcqSubmittedAt    DateTime?
  mcqScore          Float?
  practicalStartedAt DateTime?
  practicalSubmittedAt DateTime?
  practicalScore    Float?
  disqualified      Boolean                 @default(false)
  disqualifyReason  String?
  checklistCompleted Boolean                @default(false)
  checklistData     Json?
  // Per-candidate recording files. Populated by finalizeRecording when
  // the multi-candidate slot finishes — each candidate's webcam + screen
  // chunks are merged independently into their own webm.
  screenRecordingPath String?
  webcamRecordingPath String?
  // Per-candidate practical assignment. In multi-candidate slots each
  // candidate can be given a different paper set or legacy task so
  // neighbours can't trivially copy. Single-candidate sessions leave
  // these null and use the session-level ExamSession columns.
  practicalPaperSetId String?
  practicalPaperSet   PracticalPaperSet? @relation(fields: [practicalPaperSetId], references: [id])
  practicalTaskId     String?
  practicalTask       PracticalTask?     @relation(fields: [practicalTaskId], references: [id])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([sessionId, candidateId])
}

model ExamAnswer {
  id                String      @id @default(cuid())
  sessionId         String
  session           ExamSession @relation(fields: [sessionId], references: [id])
  // Which candidate submitted this answer. Backfilled from session.candidateId
  // for legacy single-candidate sessions. Required so multi-candidate slots
  // don't collide their answers into a shared bucket.
  candidateId       String
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id])
  position          Int
  questionSnapshot  Json
  candidateResponse Json
  isCorrect         Boolean
  correctAnswer     Json
  timeSpentSeconds  Int
  marks             Float
  maxMarks          Float
  submittedAt       DateTime    @default(now())

  @@index([sessionId, candidateId])
}

model ProctorChecklist {
  id                      String      @id @default(cuid())
  sessionId               String
  session                 ExamSession @relation(fields: [sessionId], references: [id])
  // Multi-candidate slots get ONE checklist row per candidate so the
  // proctor's progress is tracked independently per person. Backfilled
  // from session.candidateId for legacy rows.
  candidateId             String
  proctorId               String
  items                   Json
  completedAt             DateTime?
  candidateNameConfirmed  String?
  candidateEmailConfirmed Boolean     @default(false)
  idPhotoPath             String?
  frVerificationResult    Json?
  recordingConsentGiven   Boolean     @default(false)
  examGuidelinesDelivered Boolean     @default(false)
  candidateAgreedToRules  Boolean     @default(false)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@unique([sessionId, candidateId])
}

model SessionEvent {
  id             String        @id @default(cuid())
  sessionId      String
  session        ExamSession   @relation(fields: [sessionId], references: [id])
  eventType      EventType
  severity       EventSeverity
  source         EventSource
  timestamp      DateTime      @default(now())
  payload        Json?
  screenshotPath String?
  reviewedBy     String?
  reviewOutcome  ReviewOutcome?
  proctorNote    String?
}

model FacialRecognitionLog {
  id                 String      @id @default(cuid())
  sessionId          String
  session            ExamSession @relation(fields: [sessionId], references: [id])
  // Which candidate this check is about. Backfilled from session.candidateId
  // on existing rows; required so multi-candidate slots attribute periodic
  // checks to the right candidate.
  candidateId        String?
  eventType          FREventType
  timestamp          DateTime    @default(now())
  capturedImagePath  String
  referenceImagePath String?
  similarityScore    Float
  outcome            FROutcome
  reviewedBy         String?
  reviewNotes        String?
  faceEmbedding      String?     // JSON string of embedding array
  landmarkData       Json?       // Optional landmark coordinates
  detectionMethod    String      @default("MEDIAPIPE")
  faceCount          Int?        // Number of faces detected
  poseData           Json?       // Optional pose detection data

  @@index([sessionId, candidateId])
}

model Report {
  id               String          @id @default(cuid())
  sessionId        String
  session          ExamSession     @relation(fields: [sessionId], references: [id])
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  // Multi-candidate slots get ONE report per candidate. For single-candidate
  // sessions this matches session.candidateId (backfilled by migration).
  candidateId      String
  mcqScore         Float
  mcqPassed        Boolean
  mcqBreakdown     Json
  practicalScore   Float?
  practicalPassed  Boolean?
  overallScore     Float
  overallPassed    Boolean
  integrityScore   Float
  competencyRadar  Json?
  aiNarrative      String?
  aiRecommendation String?
  proctorNarrative String?
  proctorVerdict   ProctorVerdict?
  practicalQuality PracticalQuality?
  proctorOverrides Json?
  status           ReportStatus    @default(DRAFT)
  publishedAt      DateTime?
  publishedBy      String?
  pdfPath          String?
  pdfVersion       Int             @default(1)
  masterProctorReview Json?
  hrRating         Int?
  hrRatingNote     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([sessionId, candidateId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  userEmail   String
  role        String
  eventType   String
  target      String?
  targetId    String?
  payload     Json?
  ipAddress   String
  chainHash   String
  createdAt   DateTime @default(now())
}

model Lead {
  id              String     @id @default(cuid())
  companyName     String
  fullName        String
  role            String
  email           String
  phone           String?
  companySize     String?
  assessmentTypes String[]
  message         String?
  status          LeadStatus @default(NEW)
  assignedAgentId String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  payload    Json?
  read       Boolean  @default(false)
  actionUrl  String?
  createdAt  DateTime @default(now())
}

model ProctorAvailability {
  id         String   @id @default(cuid())
  proctorId  String
  dayOfWeek  Int
  startTime  String
  endTime    String
  timezone   String
  isOverride Boolean  @default(false)
  overrideDate DateTime?
  overrideReason String?
  createdAt  DateTime @default(now())
}

model Interview {
  id            String   @id @default(cuid())
  organizationId String
  candidateId   String
  // The exam session this interview is anchored to. The reference photo
  // captured during that session's verification is what an interview-time
  // FR check would compare a live frame against.
  sessionId     String?
  scheduledAt   DateTime
  format        String   @default("VIDEO")
  // SCHEDULED -> IN_PROGRESS -> COMPLETED / CANCELLED
  status        String   @default("SCHEDULED")
  interviewers  String[]
  notes         String?
  verdict       String?
  scheduledBy   String?
  hrUserId      String?
  // Magic-link join (same pattern exam sessions use). NOT NULL was safe
  // because the Interview table is empty scaffolding today; if you wire
  // up the full schedule flow, populate these in the service before any
  // .create call.
  magicToken    String   @unique
  tokenExpiresAt DateTime
  startedAt     DateTime?
  endedAt       DateTime?
  impression    String?
  recommendation String?
  recordingPath String?
  // Reserved for a future auto-FR-during-interview check against the
  // candidate's stored reference photo. Wired in DB but not yet used
  // by the service.
  frVerdict     String?
  frSimilarity  Float?
  frCheckedAt   DateTime?
  manualVerified Boolean?
  manualVerifyNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId, status, scheduledAt])
  @@index([candidateId])
}

model UserInvitation {
  id             String   @id @default(cuid())
  email          String
  role           UserRole
  organizationId String?
  invitedBy      String
  token          String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([email, organizationId])
}

model PlatformSettings {
  id                    String   @id @default(cuid())
  key                   String   @unique
  value                 Json
  updatedBy             String?
  updatedAt             DateTime @updatedAt
}

// ── CMS ──────────────────────────────────────────────────────────────
// Content for the public marketing site. Managed via the separate CMS
// admin (/cms) by CMS_ADMIN / CMS_EDITOR users. Read publicly (no auth)
// by the Next.js marketing pages for SSR/SEO.

enum CmsContentStatus {
  DRAFT
  PUBLISHED
}

// One row per marketing page (home, about, services, contact). The
// editable section content lives in `content` (structured JSON) so the
// shape can evolve without a migration per tweak; SEO fields are first-
// class columns because they are queried/rendered uniformly.
model CmsPage {
  id              String           @id @default(cuid())
  slug            String           @unique // home | about | services | contact
  title           String
  status          CmsContentStatus @default(PUBLISHED)
  content         Json             @default("{}")
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  keywords        String[]         @default([])
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CmsPost {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  excerpt         String?
  // Sanitised HTML body (sanitised again on the client before render).
  body            String           @default("")
  coverImage      String?
  tags            String[]         @default([])
  status          CmsContentStatus @default(DRAFT)
  authorName      String?
  metaTitle       String?
  metaDescription String?
  keywords        String[]         @default([])
  publishedAt     DateTime?
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, publishedAt])
}

model CmsMedia {
  id         String   @id @default(cuid())
  url        String   // public /uploads/* path
  filename   String
  mimeType   String
  size       Int
  alt        String?
  uploadedBy String?
  createdAt  DateTime @default(now())
}
